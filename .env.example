# =============================================================================
# Variáveis de ambiente do SaaS Locô — TEMPLATE (pendência #08)
#
# Este arquivo é o inventário completo. NUNCA coloque valores reais aqui:
# ele é versionado. Os valores vivem em:
#
#   * Produção/Staging → secrets do Worker Cloudflare
#       npx wrangler secret put <NOME> --env production
#       npx wrangler secret list --env production   (mostra só os NOMES)
#   * Desenvolvimento  → .dev.vars.saas  (gitignored; espelha estes nomes)
#   * Pré-deploy       → npm run check:secrets -- staging|production
#       (scripts/verificar-secrets.mjs confere presença + formato)
#
# Todos os secrets abaixo também estão declarados em "secrets.required" no
# wrangler.jsonc de cada ambiente: se faltar algum, o wrangler avisa em dev e o
# script de pré-deploy BLOQUEIA o deploy (antes o deploy passava e o sistema
# operava sem cobrança e sem e-mail, silenciosamente).
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS (valor sensível; nunca commitado, nunca no cliente)
# -----------------------------------------------------------------------------

# --- Notificações push (VAPID — gerados para ESTE projeto; obrigatórios) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cobrança Asaas (Etapa 3) ---
# ASAAS_API_KEY: access_token da API v3 (produção: $aact_...; sandbox: $aact_sandbox_...).
ASAAS_API_KEY=
# ASAAS_ENVIRONMENT: SOMENTE "production" ou "sandbox".
#   Em produção OBRIGATORIAMENTE "production" (api.asaas.com). Se ficar em
#   "sandbox", a cobrança real nunca acontece e o sistema parece funcionar.
ASAAS_ENVIRONMENT=production
# ASAAS_WEBHOOK_TOKEN: segredo do webhook /api/webhooks/asaas?token=...
ASAAS_WEBHOOK_TOKEN=

# --- E-mail transacional Resend (Etapa 5) ---
# RESEND_API_KEY: chave da conta do Resend (padrão re_...).
RESEND_API_KEY=
# RESEND_FROM: remetente com DOMÍNIO PRÓPRIO VERIFICADO na conta do Resend,
#   ex.: "Locô <no-reply@seudominio.com.br>".
#   O domínio de teste resend.dev NÃO é aceito pelo sistema (só entrega para o
#   dono da conta) e não existe mais fallback automático: sem RESEND_FROM ou
#   com resend.dev o envio é pulado e a falha aparece em /erros (fail-open,
#   visível). Configurar o domínio em Resend → Domains + DNS (SPF/DKIM).
RESEND_FROM=

# -----------------------------------------------------------------------------
# VARS (não sensíveis; declaradas em wrangler.jsonc "vars", por ambiente)
# -----------------------------------------------------------------------------
# NOMINATIM_URL=https://nominatim.openstreetmap.org/
# OSRM_URL=https://routing.openstreetmap.de/routed-car
# VAPID_SUBJECT=mailto:admin@seudominio.com.br
# PUBLIC_URL=<origem pública do ambiente; usada nos links dos e-mails do cron>
#   staging:   https://limas-saas-staging.limas-locacoes.workers.dev
#   production: https://limas-saas.limas-locacoes.workers.dev
