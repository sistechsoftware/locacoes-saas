{
  "name": "limas-locacoes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3210",
    "build": "next build --turbopack",
    "start": "next start -p 3210",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "tsx --conditions=react-server --test tests/**/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply limas-locacoes --local",
    "db:migrate": "wrangler d1 migrations apply limas-locacoes --remote"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "^15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
