{
  "$schema": "node_modules/wrangler/config-schema.json",
  // =============================================================================
  // NOVO PROJETO SAAS — infraestrutura PRÓPRIA e ISOLADA da Lima's Locações.
  //
  //  * NÃO utilize aqui o Worker/D1 da aplicação atual da Lima's Locações
  //    (database_id antigo 79a1d43c-8355-4689-9f11-5ff461e48c58 — INTOCÁVEL).
  //  * Deploy SEMPRE com ambiente explícito:
  //      npm run deploy:staging      -> wrangler deploy --env staging
  //      npm run deploy:production   -> wrangler deploy --env production
  //    O bloco padrão (top-level) serve só ao desenvolvimento local e nunca é
  //    deployado.
  //  * Secrets por ambiente (nunca commitados) — declarados em secrets.required
  //    abaixo (pendência #08: sem declaração o deploy passava e o sistema
  //    operava sem cobrança/e-mail em silêncio). Nas envs NAMED o trio Asaas
  //    fica FORA do secrets.required — esse campo do wrangler só aceita o
  //    caminho do Worker e bloquearia o deploy com credenciais no painel /saas;
  //    quem cobra os dois caminhos é o pré-deploy (scripts/verificar-secrets.mjs):
  //      VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY       -> SEMPRE secret do Worker
  //      RESEND_API_KEY, RESEND_FROM               -> SEMPRE secret do Worker
  //      ASAAS_API_KEY, ASAAS_ENVIRONMENT,
  //      ASAAS_WEBHOOK_TOKEN                       -> cobrança Asaas (Worker OU
  //        painel /saas: platform_settings no D1 + PAINEL_CHAVE no Worker;
  //        asaas_environment em produção só aceita "production" — sandbox é
  //        bloqueio de deploy)
  //    Pré-deploy: npm run check:secrets -- staging|production (scripts/verificar-secrets.mjs)
  //      (o bloco top-level mantém o trio em secrets.required para typegen/local
  //       — ele nunca é deployado)
  // =============================================================================
  "name": "limas-saas",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NOMINATIM_URL": "https://nominatim.openstreetmap.org/",
    "OSRM_URL": "https://routing.openstreetmap.de/routed-car",
    "VAPID_SUBJECT": "mailto:uericlislima@gmail.com",
    "PUBLIC_URL": "",
    // Chave PÚBLICA do Google Maps (restrita por origem no Console) só para
    // carregar o mapa da calculadora de frete no navegador. Opcional: vazia =
    // calculadora funciona sem mapa (provedor OSM). A chave server-side
    // GOOGLE_MAPS_API_KEY é SECRET do Worker (wrangler secret put) e não
    // pode entrar aqui.
    "GOOGLE_MAPS_CLIENT_KEY": ""
  },
  "triggers": { "crons": ["* * * * *"] },
  // o guarda do Next nao se aplica ao Worker e impedia o cron de rodar
  "alias": { "server-only": "./src/lib/server-only-worker.ts" },
  "secrets": {
    "required": [
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
      "ASAAS_API_KEY",
      "ASAAS_ENVIRONMENT",
      "ASAAS_WEBHOOK_TOKEN",
      "RESEND_API_KEY",
      "RESEND_FROM"
    ]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "limas-saas-db",
      "database_id": "8f5a97e8-fe8c-42c7-869d-b1d7ed709969"
    }
  ],
  "env": {
    // ===========================================================================
    // STAGING — Worker e D1 PRÓPRIOS, sem qualquer vínculo com produção do SaaS
    // e com a Lima's Locações.
    //   deploy:  npm run deploy:staging
    //   migrations: npm run db:migrate:staging
    // ===========================================================================
    "staging": {
      "name": "limas-saas-staging",
      "main": "custom-worker.ts",
      "compatibility_date": "2026-09-03",
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "NOMINATIM_URL": "https://nominatim.openstreetmap.org/",
        "OSRM_URL": "https://routing.openstreetmap.de/routed-car",
        "VAPID_SUBJECT": "mailto:uericlislima@gmail.com",
        // Domínio público do Locô (Cloudflare -> Worker). Usado nos links dos
        // e-mails gerados pelo cron (fim de trial, cobrança gerada) — em request
        // os links saem do host que o usuário acessou.
        "PUBLIC_URL": "https://locogestao.com.br",
        // Mapa da calculadora de frete (opcional; vazia = sem mapa).
        "GOOGLE_MAPS_CLIENT_KEY": ""
      },
      "triggers": { "crons": ["* * * * *"] },
      "secrets": {
        // Trio Asaas fora daqui (pendência #08): o secrets.required do wrangler
        // só aceita o caminho do Worker — quem cobra Worker OU painel é o
        // pré-deploy (scripts/verificar-secrets.mjs).
        "required": [
          "VAPID_PUBLIC_KEY",
          "VAPID_PRIVATE_KEY",
          "RESEND_API_KEY",
          "RESEND_FROM"
        ]
      },
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "limas-saas-staging-db",
          "database_id": "74c709de-e5a4-4985-ae5f-4ae03e991ba4"
        }
      ]
    },
    // ===========================================================================
    // PRODUÇÃO do SaaS — banco NOVO e VAZIO (somente migrations; nenhum dado
    // da Lima's Locações é copiado). O primeiro acesso real nasce do fluxo de
    // onboarding, sem seed de credenciais.
    //   deploy:  npm run deploy:production
    //   migrations: npm run db:migrate
    // ===========================================================================
    "production": {
      "name": "limas-saas",
      "main": "custom-worker.ts",
      "compatibility_date": "2026-09-03",
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "NOMINATIM_URL": "https://nominatim.openstreetmap.org/",
        "OSRM_URL": "https://routing.openstreetmap.de/routed-car",
        "VAPID_SUBJECT": "mailto:uericlislima@gmail.com",
        // Domínio público do Locô (Cloudflare -> Worker): origem dos links dos
        // e-mails enviados pelo cron.
        "PUBLIC_URL": "https://locogestao.com.br",
        // Mapa da calculadora de frete (opcional; vazia = sem mapa).
        "GOOGLE_MAPS_CLIENT_KEY": ""
      },
      "triggers": { "crons": ["* * * * *"] },
      "secrets": {
        // Produção opera o Asaas pelo painel /saas (platform_settings +
        // PAINEL_CHAVE), então o trio ASAAS_* NÃO está aqui: o secrets.required
        // do wrangler bloquearia esse caminho no deploy. O pré-deploy cobra os
        // dois caminhos e ainda valida o VALOR — asaas_environment em produção
        // só aceita "production" (sandbox é bloqueio, pendência #08).
        "required": [
          "VAPID_PUBLIC_KEY",
          "VAPID_PRIVATE_KEY",
          "RESEND_API_KEY",
          "RESEND_FROM"
        ]
      },
      "observability": { "enabled": true, "head_sampling_rate": 0.1 },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "limas-saas-db",
          "database_id": "8f5a97e8-fe8c-42c7-869d-b1d7ed709969"
        }
      ]
    }
  }
}
